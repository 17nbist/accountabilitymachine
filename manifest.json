{
  "manifest_version": 3,
  "name": "Accountability Machine",
  "version": "4.0.0",
  "description": "AI accountability buddy for interview prep: LeetCode solves and solve times, Zetamac scores, probability/C++/project tracks, four mock-interview modes, distraction overlay, and a self-editing memory.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "alarms",
    "notifications",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://leetcode.com/*",
    "https://arithmetic.zetamac.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "log.js",
        "shared.js",
        "practice.js",
        "content-lc.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "inpage-monaco.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.reddit.com/*",
        "https://*.twitter.com/*",
        "https://x.com/*",
        "https://*.instagram.com/*",
        "https://*.twitch.tv/*"
      ],
      "js": [
        "log.js",
        "shared.js",
        "content-distraction.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://arithmetic.zetamac.com/*"
      ],
      "js": [
        "log.js",
        "shared.js",
        "practice.js",
        "content-zetamac.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Accountability Machine",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
