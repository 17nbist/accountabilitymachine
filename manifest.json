{
  "manifest_version": 3,
  "name": "Accountability Machine",
  "version": "2.6.0",
  "description": "AI accountability buddy for the LeetCode grind. Auto-detects your solves, nudges you past distractions, runs mock interviews, and maintains its own memory of you.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabs", "alarms", "notifications"],
  "host_permissions": ["https://openrouter.ai/*", "https://leetcode.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["log.js", "shared.js", "content-lc.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://leetcode.com/*"],
      "js": ["inpage-monaco.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.youtube.com/*",
        "https://*.reddit.com/*",
        "https://*.twitter.com/*",
        "https://x.com/*",
        "https://*.instagram.com/*",
        "https://*.twitch.tv/*"
      ],
      "js": ["log.js", "shared.js", "content-distraction.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Accountability Machine",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
