{
  "name": "accountability-machine",
  "version": "4.0.0",
  "private": true,
  "description": "Chrome MV3 side-panel AI accountability buddy for interview prep",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check.js",
    "check:no-bank": "node scripts/check-no-bank.js",
    "lock:write": "node scripts/lock.js write",
    "lock:verify": "node scripts/lock.js verify",
    "lock:restore": "node scripts/lock.js restore",
    "test:holdout": "node scripts/test-holdout.js",
    "test:coverage": "node --test --experimental-test-coverage '--test-coverage-include=prep/*.js' --test-coverage-lines=90 tests/*.test.js",
    "bank:build": "node bank-build/build.js",
    "e2e": "node e2e/run.js"
  },
  "devDependencies": {
    "playwright": "^1.58.2"
  }
}
